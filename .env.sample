##
# CORS
##
CORS_ORIGIN='[/(https|http)(:\/\/)?(.*\.)?matsak\.com.*/]'

##
# MongoDB Configuration
##
# Local development (non-Docker)
DB_URI_PRODUCTION="mongodb://localhost/matsakprod"
DB_URI_DEMO="mongodb://localhost/matsakdemo"
DB_URI_DEV="mongodb://localhost/matsak"
DB_URI="mongodb://localhost/matsak"
DEBUG_MONGOOSE=false

# Docker MongoDB Credentials (REQUIRED for production)
MONGO_ROOT_USERNAME=matsak_admin
MONGO_ROOT_PASSWORD=your-secure-admin-password-here
MONGO_APP_USERNAME=matsak_user
MONGO_APP_PASSWORD=your-secure-app-password-here

# Docker MongoDB Connection (automatically constructed)
MONGO_URI=mongodb://matsak_user:your-secure-app-password-here@mongodb:27017/matsak?authSource=matsak

##
# Security
##
JWT_SECRET=your-super-secure-jwt-secret-at-least-64-characters-long-for-production

