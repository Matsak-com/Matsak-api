##
# CORS
##
CORS_ORIGIN='[/(https|http)(:\/\/)?(.*\.)?your-domain\.com.*/]'

##
# MongoDB Configuration
##
# Local development (non-Docker)
DB_URI_PRODUCTION="mongodb://localhost/your-prod-db"
DB_URI_DEMO="mongodb://localhost/your-demo-db"
DB_URI_DEV="mongodb://localhost/your-dev-db"
DB_URI="mongodb://localhost/your-dev-db"
DEBUG_MONGOOSE=false

# Docker MongoDB Credentials (REQUIRED for production)
MONGO_ROOT_USERNAME=your-mongo-root-username
MONGO_ROOT_PASSWORD=your-secure-admin-password-here
MONGO_APP_USERNAME=your-mongo-app-username
MONGO_APP_PASSWORD=your-secure-app-password-here

# Docker MongoDB Connection (automatically constructed)
MONGO_URI=mongodb://your-mongo-app-username:your-secure-app-password-here@mongodb:27017/matsak?authSource=matsak

##
# Security
##
JWT_SECRET=your-super-secure-jwt-secret-at-least-64-characters-long-for-production

## AWS ##
AWS_ACCESS_KEY=your-aws-access-key-here
AWS_SECRET=your-aws-secret-access-key-here
AWS_BUCKET_NAME=your-s3-bucket-name
AWS_REGION=your-aws-region

## Google oauth2.0 ##
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
JWT_SECRET=your-jwt-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

## Facebook oauth2.0 ##
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=http://localhost:3000/auth/facebook/callback

##
# Email Configuration
##
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Your App Name <noreply@your-domain.com>"

##
# Redis Configuration (for job queue)
##
REDIS_HOST=localhost
REDIS_PORT=6379

##
# SMS Configuration (future implementation)
##
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=your-twilio-phone-number

# CLOUDFLARE KEY
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key

# Contact email
CONTACT_EMAIL="contact@matsak-mg.com"