{{> header}}

<div class="content">
    <h2>{{t.title}}</h2>
    <p class="greeting">{{t.greeting}}, {{customer.name}}</p>
    <p>{{t.thankYou}}</p>

    {{!-- Infos paiement --}}
    <table class="info-table">
        <tr>
            <td class="info-label">{{t.invoiceNumber}}</td>
            <td class="info-value">{{invoiceNumber}}</td>
        </tr>
        <tr>
            <td class="info-label">{{t.invoiceDate}}</td>
            <td class="info-value">{{invoiceDate}}</td>
        </tr>
        <tr>
            <td class="info-label">{{t.paymentMethod}}</td>
            <td class="info-value">{{payment.method}}</td>
        </tr>
        <tr>
            <td class="info-label">{{t.transactionRef}}</td>
            <td class="info-value meta-mono">{{payment.transactionReference}}</td>
        </tr>
        {{#if payment.customerPhone}}
        <tr>
            <td class="info-label">{{t.phone}}</td>
            <td class="info-value">{{payment.customerPhone}}</td>
        </tr>
        {{/if}}
    </table>

    {{!-- Articles groupés par team --}}
    <h3 class="section-title">{{t.orderedItems}}</h3>

    {{#each teams}}
    <div class="team-block">
        <div class="team-header">{{this.teamName}}</div>
        <table class="items-table">
            <thead>
                <tr>
                    <th class="col-name">{{../t.itemName}}</th>
                    <th class="col-qty">{{../t.quantity}}</th>
                    <th class="col-price">{{../t.unitPrice}}</th>
                    <th class="col-total">{{../t.total}}</th>
                </tr>
            </thead>
            <tbody>
                {{#each this.items}}
                <tr>
                    <td class="col-name">{{this.name}}</td>
                    <td class="col-qty">{{this.quantity}}</td>
                    <td class="col-price">{{this.unitPrice}} {{../../currency}}</td>
                    <td class="col-total">{{this.totalPrice}} {{../../currency}}</td>
                </tr>
                {{/each}}
            </tbody>
            <tfoot>
                <tr class="subtotal-row">
                    <td colspan="3" class="subtotal-label">{{../t.subtotal}} — {{this.teamName}}</td>
                    <td class="subtotal-value">{{this.subtotal}} {{../currency}}</td>
                </tr>
            </tfoot>
        </table>
    </div>
    {{/each}}

    {{!-- ════════════════════════════════════════════════════════ --}}
    {{!-- RÉCAPITULATIF PRICING                                    --}}
    {{!-- Sous-total → surcharges → remise → TOTAL                 --}}
    {{!-- ════════════════════════════════════════════════════════ --}}
    <table class="pricing-summary-table">

        {{!-- Sous-total articles --}}
        <tr class="pricing-row">
            <td class="pricing-label">{{t.subtotalItems}}</td>
            <td class="pricing-value">{{subtotalLocal}} {{currency}}</td>
        </tr>

        {{!-- Lignes de surcharges (livraison, service, haute demande…) --}}
        {{#each pricingLines}}
        <tr class="pricing-row pricing-surcharge">
            <td class="pricing-label">{{this.name}}</td>
            <td class="pricing-value">+ {{this.localPrice}} {{../currency}}</td>
        </tr>
        {{/each}}

        {{!-- Remise promo code --}}
        {{#if promoCodeSnapshot}}
        <tr class="pricing-row pricing-discount">
            <td class="pricing-label">
                {{t.promoCode}} <span class="promo-code-badge">{{promoCodeSnapshot.code}}</span>
            </td>
            <td class="pricing-value pricing-discount-value">− {{discountLocal}} {{currency}}</td>
        </tr>
        {{/if}}

        {{!-- Séparateur visuel avant le total --}}
        <tr class="pricing-divider">
            <td colspan="2"><hr/></td>
        </tr>

        {{!-- Total final — correspond exactement à ce que le client a payé --}}
        <tr class="pricing-row pricing-total">
            <td class="pricing-label">{{t.totalPaid}}</td>
            <td class="pricing-value">{{totalLocal}} {{currency}}</td>
        </tr>

    </table>

    {{!-- ════════════════════════════════════ --}}
    {{!-- MODE LIVRAISON                       --}}
    {{!-- ════════════════════════════════════ --}}
    {{#unless isPickup}}

    {{#if deliveryAddress}}
    <div class="shipping-block">
        <h3 class="section-title">{{t.shippingAddress}}</h3>
        <p class="shipping-info">
            {{deliveryAddress.name}}<br/>
            {{deliveryAddress.addressLine}}<br/>
            {{deliveryAddress.city}}{{#if deliveryAddress.state}}, {{deliveryAddress.state}}{{/if}}
            {{#if deliveryAddress.phone}}<br/>{{deliveryAddress.phone}}{{/if}}
        </p>
    </div>
    {{/if}}

    {{#if deliveryQrDataUri}}
    <div class="qr-block qr-delivery">
        <h3 class="section-title">{{t.deliveryQrTitle}}</h3>
        <p class="qr-description">{{t.deliveryQrDescription}}</p>
        <div class="qr-image-wrapper">
            <img src="{{deliveryQrDataUri}}" alt="QR Code livraison" width="200" height="200" class="qr-image" />
        </div>
        <p class="qr-meta">{{t.deliveryQrMeta}}</p>
    </div>
    {{/if}}

    {{/unless}}

    {{!-- ════════════════════════════════════ --}}
    {{!-- MODE RETRAIT : un QR par pharmacie   --}}
    {{!-- ════════════════════════════════════ --}}
    {{#if isPickup}}

    <h3 class="section-title">{{t.pickupQrTitle}}</h3>
    <p>{{t.pickupQrDescription}}</p>

    {{#each teams}}
    {{#if this.qrDataUri}}
    <div class="qr-block qr-pickup">
        <div class="qr-pharmacy-name">{{this.teamName}}</div>
        <div class="qr-image-wrapper">
            <img src="{{this.qrDataUri}}" alt="QR Code {{this.teamName}}" width="200" height="200" class="qr-image" />
        </div>
        <p class="qr-meta">{{../t.pickupQrMeta}} {{this.teamName}}</p>
    </div>
    {{/if}}
    {{/each}}

    {{/if}}

    <p>{{t.support}}</p>
    <p class="signature">{{{t.signature}}}</p>
</div>

{{> footer}}
