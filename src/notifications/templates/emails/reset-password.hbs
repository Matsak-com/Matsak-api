{{> header}}

<div class="content">

    <!-- Icon + Title -->
    <div style="text-align:center; margin-bottom:28px;">
        <table cellpadding="0" cellspacing="0" role="presentation" style="margin:0 auto 16px auto;">
            <tr>
                <td style="width:64px; height:64px; background:linear-gradient(135deg,#e0f7fa,#b2ebf2); border-radius:50%; text-align:center; vertical-align:middle; font-size:30px; line-height:64px;">
                    &#128274;
                </td>
            </tr>
        </table>
        <h2 style="margin:0; font-size:24px; font-weight:700; color:#1a2b3c;">{{t.title}}</h2>
    </div>

    <!-- Greeting -->
    <p style="font-size:16px; font-weight:500; color:#2d3748; margin:0 0 16px 0;">{{t.greeting}}, <strong>{{user.firstName}} {{user.lastName}}</strong>,</p>
    <p style="color:#4a5568; margin:0 0 28px 0; line-height:1.7;">{{t.instruction}}</p>

    <!-- CTA Button -->
    <div style="text-align:center; margin:32px 0;">
        <a href="{{resetUrl}}"
           style="display:inline-block; padding:16px 40px; background:linear-gradient(135deg,#5dc760,#3db640); color:#ffffff; text-decoration:none; border-radius:8px; font-weight:700; font-size:16px; letter-spacing:0.4px; box-shadow:0 4px 14px rgba(93,199,96,0.35);">
            {{t.resetButton}}
        </a>
    </div>

    <!-- Divider -->
    <hr style="border:none; border-top:1px solid #e9ecef; margin:28px 0;">

    <!-- Expiry warning -->
    <table width="100%" cellspacing="0" cellpadding="0" style="background:#fffbeb; border:1px solid #fcd34d; border-radius:10px; margin:0 0 20px 0;">
        <tr>
            <td style="padding:18px 20px;">
                <table cellspacing="0" cellpadding="0">
                    <tr>
                        <td style="font-size:22px; padding-right:12px; vertical-align:top;">⏱</td>
                        <td>
                            <p style="margin:0 0 4px 0; font-weight:700; font-size:14px; color:#92400e;">{{t.expiryTitle}}</p>
                            <p style="margin:0 0 4px 0; color:#4a5568; font-size:14px;">{{t.validFor}}</p>
                            <p style="margin:0; color:#4a5568; font-size:14px;">{{t.singleUse}}</p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    <!-- Fallback URL -->
    <div style="background:#f8f9fa; border:1px solid #e9ecef; border-radius:8px; padding:16px 18px; margin:0 0 24px 0;">
        <p style="margin:0 0 8px 0; font-size:12px; font-weight:600; color:#6b7280; text-transform:uppercase; letter-spacing:0.5px;">{{t.fallbackLabel}}</p>
        <p style="margin:0; font-size:12px; word-break:break-all; font-family:'Courier New',monospace; color:#2c3e50; background:#ffffff; border:1px solid #e9ecef; border-radius:4px; padding:10px 12px;">{{resetUrl}}</p>
    </div>

    <!-- Security notice -->
    <table width="100%" cellspacing="0" cellpadding="0" style="background:#f0fdf4; border:1px solid #bbf7d0; border-radius:10px; margin:0 0 20px 0;">
        <tr>
            <td style="padding:16px 20px;">
                <table cellspacing="0" cellpadding="0">
                    <tr>
                        <td style="font-size:20px; padding-right:10px; vertical-align:top;">🛡️</td>
                        <td>
                            <p style="margin:0; font-size:14px; color:#166534; line-height:1.6;">{{t.noRequest}}</p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    <!-- Support contact -->
    <table width="100%" cellspacing="0" cellpadding="0" style="background:#f0f9ff; border:1px solid #bae6fd; border-radius:10px; margin:0 0 28px 0;">
        <tr>
            <td style="padding:16px 20px;">
                <table cellspacing="0" cellpadding="0">
                    <tr>
                        <td style="font-size:20px; padding-right:10px; vertical-align:top;">💬</td>
                        <td>
                            <p style="margin:0; font-size:14px; color:#0369a1; line-height:1.6;">
                                {{t.contactSupport}}
                                <a href="mailto:{{platform.supportEmail}}" style="color:#0369a1; font-weight:700; text-decoration:none;">{{platform.supportEmail}}</a>
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    <!-- Signature -->
    <p style="margin:0; font-size:14px; color:#4a5568; line-height:1.7;">{{{t.signature}}}</p>

</div>

{{> footer}}