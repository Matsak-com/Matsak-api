{{> header}}

<div class="content">
    <h2>{{t.title}}</h2>
    <p class="greeting">{{t.greeting}}</p>
    <p class="important">{{t.instruction}}</p>
    <a href="{{verificationUrl}}" class="button">{{t.verifyButton}}</a>
    <p>{{t.validFor}}</p>
    <p>{{t.noAccount}}</p>
    <p class="signature">{{{t.signature}}}</p>
</div>

{{> footer}}