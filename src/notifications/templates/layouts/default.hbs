<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{subject}}</title>
    <style>
        /* Styles de base */
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            line-height: 1.6;
            color: #2c3e50;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
            background-color: #f8f9fa;
        }
        .container {
            background-color: #ffffff;
            padding: 0;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            overflow: hidden;
        }
        
        /* Header avec logo */
        .header {
            text-align: center;
            padding: 35px 30px 25px;
            background: linear-gradient(to right, #a3d4d8, #71e2ec);
        }
        .logo {
            max-width: 180px;
            height: auto;
        }
        
        /* Contenu principal */
        .content {
            padding: 40px;
        }
        
        /* Styles des titres */
        .content h2 {
            color: #1a2b3c;
            font-size: 26px;
            font-weight: 700;
            margin: 0 0 25px 0;
            line-height: 1.3;
            letter-spacing: -0.3px;
        }
        .content h3 {
            color: #2c3e50;
            font-size: 18px;
            font-weight: 600;
            margin: 30px 0 18px 0;
        }
        
        /* Styles des paragraphes */
        .content p {
            color: #4a5568;
            font-size: 15.5px;
            line-height: 1.7;
        }
        
        /* Premier paragraphe */
        .content .greeting {
            font-size: 16px;
            font-weight: 500;
            color: #2d3748;
            margin-bottom: 22px;
        }
        
        /* Paragraphes importants */
        .content .important {
            background-color: rgba(93, 199, 96, 0.08);
            padding: 18px 20px;
            border-radius: 8px;
            border-left: 4px solid #5dc760;
            margin: 25px 0;
            line-height: 1.7;
        }
        
        /* Signature */
        .content .signature {
            margin-top: 30px;
            padding-top: 25px;
            border-top: 1px solid #e9ecef;
            font-size: 15px;
        }
        
        /* Bouton principal */
        .button {
            display: inline-block;
            padding: 15px 32px;
            background-color: #5dc760;
            color: #ffffff;
            text-decoration: none;
            border-radius: 6px;
            margin: 25px 0;
            font-weight: 600;
            font-size: 15.5px;
            letter-spacing: 0.3px;
            text-align: center;
            transition: all 0.2s ease;
            box-shadow: 0 3px 8px rgba(93, 199, 96, 0.2);
        }
        .button:hover {
            background-color: #52b856;
            transform: translateY(-1px);
            box-shadow: 0 5px 12px rgba(93, 199, 96, 0.25);
        }
        
        /* Table */
        .order-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            margin: 25px 0;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }
        .order-table th {
            background-color: #f8f9fa;
            color: #4a5568;
            font-weight: 600;
            font-size: 14px;
            padding: 14px 12px;
            text-align: left;
            border-bottom: 2px solid #e9ecef;
        }
        .order-table td {
            padding: 12px;
            border-bottom: 1px solid #e9ecef;
            font-size: 14.5px;
        }
        .order-table tfoot tr:last-child {
            background-color: #f8f9fa;
        }
        .order-table tfoot td {
            font-weight: 600;
            border-bottom: none;
        }
        
        /* Section info commande */
        .order-info {
            background-color: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            margin: 25px 0;
            border-left: 3px solid #5dc760;
        }
        .order-info p {
            margin: 8px 0;
        }
        
        /* Footer */
        .footer {
            text-align: center;
            padding: 25px 40px;
            background-color: #f9f9f9;
            color: #666;
            font-size: 13px;
            line-height: 1.6;
            border-top: 1px solid #eee;
        }
        .footer-links {
            margin: 15px 0;
        }
        .footer-link {
            color: #5dc760;
            text-decoration: none;
            margin: 0 10px;
            font-size: 12px;
        }
        .footer-link:hover {
            text-decoration: underline;
        }
        .copyright {
            font-size: 12px;
            color: #888;
            margin-top: 15px;
        }
        
        /* Responsive */
        @media (max-width: 600px) {
            .content {
                padding: 25px;
            }
            .header {
                padding: 25px 20px 20px;
            }
            .content h2 {
                font-size: 24px;
            }
            .button {
                padding: 14px 28px;
                display: block;
            }
            .footer {
                padding: 20px 25px;
            }
            .order-table {
                font-size: 14px;
            }
            .order-table th,
            .order-table td {
                padding: 10px 8px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        {{{body}}}
    </div>
</body>
</html>