# Docker Environment Configuration
NODE_ENV=production
PORT=8080

# Database Configuration
MONGO_URI=mongodb://mongodb:27017/matsak
DB_URI=mongodb://mongodb:27017/matsak
DB_URI_PRODUCTION=mongodb://mongodb:27017/matsakprod
DB_URI_DEMO=mongodb://mongodb:27017/matsakdemo
DB_URI_DEV=mongodb://mongodb:27017/matsak
DEBUG_MONGOOSE=false

# JWT Configuration
JWT_SECRET=your-jwt-secret-change-in-production

# CORS Configuration
CORS_ORIGIN=["http://localhost:3000","http://localhost:3001","http://localhost:8080","http://localhost:8081","http://localhost:5173"]

# AWS Configuration (use environment-specific values)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=matsak-images-files
AWS_REGION=eu-north-1

# OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8080/auth/google/callback

FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=http://localhost:8080/auth/facebook/callback