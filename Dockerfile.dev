FROM node:20-alpine

WORKDIR /app

# Install system dependencies required for native modules
RUN apk update && apk add --no-cache build-base g++ cairo-dev pango-dev libpng-dev python3 make

# Enable pnpm via corepack and activate a pnpm version
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy package files first for better caching
COPY package*.json pnpm-lock.yaml ./

# Install all dependencies (including dev dependencies)
RUN pnpm install --frozen-lockfile


# Copy source code
COPY . .

# Expose the application port
EXPOSE 8080

# Install dependencies into the named volume (in case node_modules is empty on first run),
# then rebuild native modules for Alpine Linux and start the dev server
# CI=true prevents pnpm from prompting for confirmation when no TTY is available
CMD ["sh", "-c", "CI=true pnpm install --frozen-lockfile && pnpm rebuild bcrypt && pnpm run dev"]