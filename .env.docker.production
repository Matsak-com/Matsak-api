# Production Environment Configuration for Docker
# Copy this file to .env and update the values

##
# Security (REQUIRED)
##
JWT_SECRET=your-super-secure-jwt-secret-at-least-64-characters-long-for-production

##
# MongoDB Credentials (REQUIRED)
##
MONGO_ROOT_USERNAME=matsak_admin
MONGO_ROOT_PASSWORD=your-secure-admin-password-here
MONGO_APP_USERNAME=matsak_user
MONGO_APP_PASSWORD=your-secure-app-password-here

##
# Application Configuration
##
NODE_ENV=production
PORT=8080
CORS_ORIGIN=["https://yourdomain.com", "https://www.yourdomain.com"]

##
# AWS Configuration (if using file uploads)
##
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-bucket-name
AWS_REGION=your-aws-region

##
# OAuth Configuration (if using social login)
##
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://yourdomain.com/auth/google/callback

FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=https://yourdomain.com/auth/facebook/callback